# ============================================================
# Local Video & Audio Generation — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ---- ElevenLabs API ----------------------------------------
# Required for text-to-speech audio generation.
# Get your key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ---- Hugging Face (optional) --------------------------------
# Required only if the SVD model is gated (requires acceptance of license).
# Get token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Set a local directory to cache downloaded models (saves re-downloading).
# Default: ~/.cache/huggingface/hub
HF_HOME=D:/models/huggingface

# ---- Device override (optional) ----------------------------
# Leave blank for auto-detection (NPU > DirectML > CUDA > CPU).
# Valid values: npu | directml | cuda | cpu
# FORCE_DEVICE=directml

# ---- AMD VitisAI NPU (optional) ----------------------------
# Path to the vaip_config.json supplied with the Ryzen AI SDK.
# Only needed when using NPU acceleration.
# VITISAI_EP_JSON_CONFIG=C:/path/to/vaip_config.json

# ---- Output directory (optional) ---------------------------
OUTPUT_DIR=output

# ---- Model cache directory (optional) ----------------------
MODEL_CACHE_DIR=D:/models/huggingface

# ---- Logging -----------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- Quality preset (optional) -----------------------------
# fast | medium | high
QUALITY=medium
